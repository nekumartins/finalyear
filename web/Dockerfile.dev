# ──────────────────────────────────────────────────
# Debate Coach — Frontend Dev Server
# Runs `npm run dev` with hot-reload via volume mount
# ──────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Install deps first (cached layer — only re-runs when package files change)
COPY web/package.json web/package-lock.json ./
RUN npm ci

# Source is bind-mounted at runtime for hot-reload, but we
# copy it here as a fallback so the image works standalone.
COPY web/ ./

EXPOSE 3000

# --host exposes the server on 0.0.0.0 so it's reachable from the host machine
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
