# Backend environment
DATABASE_URL=postgresql+asyncpg://debate:debate_pass@localhost:5432/debate_coach
# Required for stable JWT sessions in production (set a strong random value)
SECRET_KEY=replace-with-openssl-rand-hex-32

# Groq API (Cloud Path) — free at console.groq.com
GROQ_API_KEY=gsk_your-key-here

# Deepgram API (Cloud STT — higher quality)
DEEPGRAM_API_KEY=your-deepgram-key-here

# Server
HOST=0.0.0.0
PORT=8000
# Set true only for local development
DEBUG=false

# Edge Models (paths — set when building Module 5)
VOSK_MODEL_PATH=models/edge/vosk-model-small-en-us
LLAMA_MODEL_PATH=models/edge/llama-2-7b-chat.Q4_K_M.gguf

# Silero VAD
VAD_THRESHOLD=0.5

# Mode: "cloud" or "edge"
DEFAULT_MODE=cloud

# Google OAuth Client ID (for Google Sign-In button)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# ── Docker dev stack ──────────────────────────────────────────────────────────
# When running via `docker compose up`, the Vite proxy uses the Docker service
# name to reach the backend. Uncomment only when running inside Docker.
# VITE_BACKEND_URL=http://backend:8000

# Optional explicit WebSocket origin override for split frontend/backend hosting
# VITE_WS_URL=wss://api.your-domain.com
